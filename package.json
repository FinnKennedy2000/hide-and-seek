{
  "name": "hide-and-seek",
  "version": "1.0.0",
  "description": "3D hide and seek in a dusk suburban house and garden (Three.js, no build step)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "smoke": "playwright test",
    "test:server": "node tests/server/run.js",
    "test:world": "node --test tests/world/*.test.mjs",
    "test:audio": "node --test tests/audio/cues.test.mjs",
    "test:chars": "node --test tests/chars/rig.test.mjs",
    "test:player": "node tests/player/controller.test.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "0.170.0",
    "ws": "^8.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^8.3.4"
  }
}
